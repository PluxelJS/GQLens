{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {},
    "gqlens-yoga-vite-codegen-example#typecheck": {
      "dependsOn": ["build"]
    },
    "gqlens-yoga-vite-codegen-example#test": {
      "dependsOn": ["build"]
    },
    "gqlens-yoga-vite-codegen-example#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "web/gqlens/**"]
    }
  }
}
