{
  "name": "gqlens",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/PluxelJS/GQLens"
  },
  "type": "module",
  "scripts": {
    "build": "vp run workspace:build",
    "test": "vp run workspace:test",
    "typecheck": "vp run workspace:types",
    "check": "vp check",
    "fix": "vp check --fix",
    "verify": "vp run workspace:verify",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "vp run release-publish",
    "publish:all": "vp run release-publish",
    "hooks:install": "hk install --mise",
    "catalog:migrate": "pncat migrate --yes",
    "catalog:detect": "pncat detect --yes"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "pncat": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  },
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "pnpm@11.28.2"
}
