{
  "name": "@gqlens/codegen",
  "version": "0.3.0",
  "description": "GQLens schema codegen — generates typed accessors, schema contract, and invalidation specs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PluxelJS/GQLens",
    "directory": "packages/codegen"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown",
    "update-fixtures": "npm run build && node scripts/update-fixtures.mjs"
  },
  "dependencies": {
    "@graphql-codegen/core": "catalog:prod",
    "@graphql-codegen/typescript": "catalog:prod",
    "@graphql-codegen/visitor-plugin-common": "catalog:prod",
    "code-block-writer": "catalog:prod"
  },
  "devDependencies": {
    "@gqlens/core": "workspace:*",
    "graphql": "catalog:backend"
  },
  "peerDependencies": {
    "@gqlens/core": "workspace:*",
    "graphql": "^16 || ^17"
  },
  "engines": {
    "node": ">=24.12"
  }
}
