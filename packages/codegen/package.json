{
  "name": "@gqlens/codegen",
  "version": "0.3.0",
  "description": "GQLens schema codegen — generates typed accessors, schema contract, and invalidation specs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PluxelJS/GQLens",
    "directory": "packages/codegen"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "vp run check-types",
    "test": "vp run check-tests",
    "build": "vp run compile",
    "update-fixtures": "vp run compile && node scripts/update-fixtures.mjs"
  },
  "dependencies": {
    "@graphql-codegen/core": "catalog:backend",
    "@graphql-codegen/typescript": "catalog:backend",
    "@graphql-codegen/visitor-plugin-common": "catalog:backend",
    "code-block-writer": "catalog:backend"
  },
  "devDependencies": {
    "@gqlens/core": "workspace:*",
    "graphql": "catalog:backend",
    "vite-plus": "catalog:tooling"
  },
  "peerDependencies": {
    "@gqlens/core": "workspace:*",
    "graphql": "^16 || ^17"
  },
  "engines": {
    "node": ">=24.12"
  }
}
