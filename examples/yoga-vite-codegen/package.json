{
  "name": "gqlens-yoga-vite-codegen-example",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "tsx tooling/generate-gqlens.ts",
    "dev": "vite",
    "dev:client": "GRAPHQL_PROXY_TARGET=http://127.0.0.1:4000 vite",
    "dev:server": "tsx src/server.ts",
    "build": "vite build",
    "typecheck": "pnpm run codegen && tsc --noEmit",
    "test": "pnpm run codegen && tsx test/frontend-contract.ts && tsx test/smoke.ts",
    "verify": "pnpm run codegen && tsc --noEmit && tsx test/frontend-contract.ts && tsx test/smoke.ts && vite build"
  },
  "dependencies": {
    "@elysiajs/node": "catalog:prod",
    "@gqlens/core": "workspace:*",
    "@gqlens/react": "workspace:*",
    "@gqlens/vite": "workspace:*",
    "@logtape/logtape": "catalog:prod",
    "elysia": "catalog:prod",
    "graphql": "catalog:yoga",
    "graphql-yoga": "catalog:prod",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitejs/plugin-react": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling"
  },
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "pnpm@11.5.2"
}
