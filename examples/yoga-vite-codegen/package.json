{
  "name": "gqlens-yoga-vite-codegen-example",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "vp run generate",
    "dev": "pitchfork start app",
    "dev:split": "pitchfork start client",
    "dev:local": "vp run serve",
    "dev:client": "vp run serve",
    "dev:server": "vp run serve-backend",
    "build": "vp run compile",
    "typecheck": "vp run check-types",
    "test": "vp run check-tests",
    "check": "vp run check-tools",
    "fix": "vp fmt && vp lint --config vite.config.ts --fix",
    "verify": "vp run example:verify"
  },
  "dependencies": {
    "@elysiajs/node": "catalog:example",
    "@gqlens/core": "workspace:*",
    "@gqlens/react": "workspace:*",
    "@gqlens/vite": "workspace:*",
    "@logtape/logtape": "catalog:example",
    "elysia": "catalog:example",
    "graphql": "catalog:example",
    "graphql-yoga": "catalog:example",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitejs/plugin-react": "catalog:frontend",
    "tsx": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vite-plus": "catalog:build"
  },
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "pnpm@11.28.2"
}
